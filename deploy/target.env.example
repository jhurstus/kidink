# kidink deploy target - copy to deploy/target.env and fill in for your own host.
#
#   cp deploy/target.env.example deploy/target.env
#
# target.env is gitignored: everything in it describes one particular private
# machine and must never be committed. Sourced by bootstrap.sh and sync-fonts.sh.

# SSH destination for the machine that runs the server.
DEPLOY_SSH=user@host

# Absolute path on that machine holding the bare repo, the checkout, the
# persistent config.toml, and app storage. Created by bootstrap.sh.
DEPLOY_ROOT=/home/user/kidink

# Unix account the service runs as, and its home directory.
DEPLOY_USER=user
DEPLOY_HOME=/home/user

# Port the server binds (on 0.0.0.0, so the board can reach it over the LAN).
DEPLOY_PORT=5051

# Absolute path to uv on the target. It has to be absolute: `ssh host '<cmd>'`
# runs a non-interactive shell that never sources ~/.profile, and systemd units
# do not source a shell at all, so neither one finds ~/.local/bin on PATH.
DEPLOY_UV=/home/user/.local/bin/uv
